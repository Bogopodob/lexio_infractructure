# ============================================================================
# Lexio infractructure — .env.example (LOCAL / DEV reference)
#
# This file documents every variable used by the compose files and shows
# LOCAL-DEV values so you don't confuse them with the real production .env.
#
#   • For LOCAL programming: this file IS the dev env source:
#       docker compose --env-file .env.example -f docker-compose.dev.yml up -d
#     (the Makefile does this for you: make up / make frontend-shell / ...)
#   • For PRODUCTION (VPS): keep secrets in .env and NEVER commit them.
#
# The committed docker-compose.yml is the production stack (php + nginx +
# postgres). The dev stack is docker-compose.dev.yml (adds the vite frontend,
# rabbitmq, published db port and xdebug).
# ============================================================================

# ----------------------------------------------------------------------------
# Compose project name + containers. 'lexio' for local, 'lexio-prod' for VPS.
# ----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=lexio

PHP_CONTAINER_NAME=lexio_php
NGINX_CONTAINER_NAME=lexio_nginx
POSTGRES_CONTAINER_NAME=lexio_postgres

# Dev-only containers (docker-compose.dev.yml).
FRONTEND_CONTAINER_NAME=lexio_frontend
RABBITMQ_CONTAINER_NAME=lexio_rabbitmq

# ----------------------------------------------------------------------------
# Ports
# ----------------------------------------------------------------------------
# nginx published port:
#   LOCAL: any free port, e.g. 8080 (serves on 127.0.0.1:8080).
#   PROD : the VPS uses 81; curatio owns 8080, deploy.sh fails if taken.
NGINX_PORT=8080

# Dev-only published ports (docker-compose.dev.yml).
FRONTEND_PORT=5173
POSTGRES_PORT=5432
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ----------------------------------------------------------------------------
# PostgreSQL credentials
# ----------------------------------------------------------------------------
POSTGRES_DB=lexio
POSTGRES_USER=lexio
# Weak value is fine locally; generate a strong one for production.
POSTGRES_PASSWORD=local-dev-password

# RabbitMQ credentials (dev-only stack).
RABBITMQ_DEFAULT_USER=lexio
RABBITMQ_DEFAULT_PASS=lexio

# ----------------------------------------------------------------------------
# Host user ids (uid/gid) the php container runs as. Keep for file perms.
# ----------------------------------------------------------------------------
APP_UID=1000
APP_GID=1000

# ----------------------------------------------------------------------------
# Xdebug (dev-only stack). Set XDEBUG_MODE=off to disable.
# ----------------------------------------------------------------------------
XDEBUG_MODE=debug
XDEBUG_CLIENT_HOST=host.docker.internal
XDEBUG_CLIENT_PORT=9003

# ----------------------------------------------------------------------------
# Hostnames baked into the frontend build (Vite) and backend config.
#   LOCAL: use localhost / 127.0.0.1.
#   PROD : app.lexio.curatio.space / api.lexio.curatio.space.
# ----------------------------------------------------------------------------
APP_HOST=localhost
API_HOST=localhost