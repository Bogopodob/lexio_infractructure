# ============================================================================
# Lexio infractructure — .env.example (LOCAL / DEV reference)
#
# This file documents every variable used by docker-compose.yml and shows
# LOCAL-DEV values so you don't confuse them with the real production .env.
#
#   • For LOCAL testing / programming: copy this file to .env and adjust.
#   • For PRODUCTION (VPS): keep secrets in .env and NEVER commit them.
#
# The committed docker-compose.yml is the production stack (php + nginx +
# postgres). For a full local dev stack (vite frontend + rabbitmq etc.) use
# the appropriate dev compose — this example only documents the variables.
# ============================================================================

# Compose project name. 'lexio' for local, 'lexio-prod' for the VPS.
COMPOSE_PROJECT_NAME=lexio

# Container names (Docker).
PHP_CONTAINER_NAME=lexio_php
NGINX_CONTAINER_NAME=lexio_nginx
POSTGRES_CONTAINER_NAME=lexio_postgres

# Port published by the container nginx.
#   LOCAL: any free port, e.g. 8080 (nginx serves on 127.0.0.1:8080).
#   PROD : the VPS uses 81; curatio owns 8080, deploy.sh fails if taken.
NGINX_PORT=8080

# PostgreSQL credentials.
POSTGRES_DB=lexio
POSTGRES_USER=lexio
# Weak value is fine locally; generate a strong one for production.
POSTGRES_PASSWORD=local-dev-password

# Host user ids (uid/gid) the php container runs as. Keep for file perms.
APP_UID=1000
APP_GID=1000

# Hostnames baked into the frontend build (Vite) and backend config.
#   LOCAL: use localhost / 127.0.0.1.
#   PROD : app.lexio.curatio.space / api.lexio.curatio.space.
APP_HOST=localhost
API_HOST=localhost

# ----------------------------------------------------------------------------
# Optional — local dev extras (not needed by the committed prod compose,
# but useful when running a full dev stack with a separate compose file).
# ----------------------------------------------------------------------------
# FRONTEND_PORT=5173
# POSTGRES_PORT=5432
# RABBITMQ_PORT=5672
# RABBITMQ_MANAGEMENT_PORT=15672
# RABBITMQ_DEFAULT_USER=lexio
# RABBITMQ_DEFAULT_PASS=lexio
#
# XDEBUG_MODE=debug
# XDEBUG_CLIENT_HOST=host.docker.internal
# XDEBUG_CLIENT_PORT=9003
