# HOST nginx (VPS, e.g. /etc/nginx/conf.d/lexio.conf) — new file only,
# curatio's vhosts are NOT touched. SSL certs come from the Jino panel
# (wildcard *.curatio.space does NOT cover app./api.lexio.* — two levels —
# so make sure the panel issued certs for BOTH hostnames below first).
#
# Replace <CERT_DIR> with the real live dir, e.g.
# /etc/letsencrypt/live/app.lexio.curatio.space (check `ls /etc/letsencrypt/live/`).

upstream lexio_upstream {
    server 127.0.0.1:8081;  # == NGINX_PORT from prod/.env
}

# --- frontend ---
server {
    listen 80;
    server_name app.lexio.curatio.space;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name app.lexio.curatio.space;

    ssl_certificate     <CERT_DIR_APP>/fullchain.pem;
    ssl_certificate_key <CERT_DIR_APP>/privkey.pem;

    # index.html must revalidate: it references hashed /assets/* by name.
    location = /index.html {
        proxy_pass http://lexio_upstream;
        add_header Cache-Control "public, max-age=0, must-revalidate" always;
    }

    location / {
        proxy_pass http://lexio_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

# --- backend ---
server {
    listen 80;
    server_name api.lexio.curatio.space;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name api.lexio.curatio.space;

    ssl_certificate     <CERT_DIR_API>/fullchain.pem;
    ssl_certificate_key <CERT_DIR_API>/privkey.pem;

    client_max_body_size 64M;

    location / {
        proxy_pass http://lexio_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
