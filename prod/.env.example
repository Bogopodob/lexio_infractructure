# Lexio PROD env (VPS, /var/www/lexio/infractructure/prod/.env).
# Copy to .env and fill in. NEVER commit the real .env.
# Local dev (infractructure/.env) is untouched by all of this.

COMPOSE_PROJECT_NAME=lexio-prod

PHP_CONTAINER_NAME=lexio_php
NGINX_CONTAINER_NAME=lexio_nginx
POSTGRES_CONTAINER_NAME=lexio_postgres

# Single published port, localhost-bound (see docker-compose.yml).
# Must be free on the VPS host (curatio uses 8080) — deploy.sh fails fast if taken.
NGINX_PORT=8081

POSTGRES_DB=lexio
POSTGRES_USER=lexio
# Generate fresh secrets on the VPS, do NOT reuse dev values:
POSTGRES_PASSWORD=CHANGEME-32-chars-min

APP_UID=1000
APP_GID=1000

# Baked into the frontend build (Vite) and backend config:
APP_HOST=app.lexio.curatio.space
API_HOST=api.lexio.curatio.space
